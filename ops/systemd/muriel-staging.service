[Unit]
Description=Muriel synthetic staging Django application
Requires=postgresql@18-main.service
After=network-online.target postgresql@18-main.service
Wants=network-online.target

[Service]
Type=exec
User=muriel_staging
Group=muriel_staging
WorkingDirectory=/srv/muriel-staging/current
EnvironmentFile=/etc/muriel-staging/environment
Environment=PRECEPTOR_DJANGO_SETTINGS_MODULE=preceptor_project.staging_settings
Environment=PRECEPTOR_GUNICORN_BIND=127.0.0.1:8082
ExecStart=/srv/muriel-staging/current/scripts/start-production
RuntimeDirectory=muriel-staging
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
