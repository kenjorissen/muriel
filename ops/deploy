#!/bin/sh
# Send one reviewed Git revision to the explicitly configured SSH target.
set -eu
umask 077

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)

. "$script_dir/require-ssh-target.sh"
ssh_target=$MURIEL_SSH_TARGET

if [ -n "$(git -C "$repo_root" status --porcelain --untracked-files=all)" ]; then
    printf '%s\n' "Deployment refuses a dirty source checkout." >&2
    exit 1
fi
commit=$(git -C "$repo_root" rev-parse --verify HEAD^{commit})
case "$commit" in
    *[!0123456789abcdef]*|???????????????????????????????????????)
        printf '%s\n' "Deployment could not identify an exact Git commit." >&2
        exit 1
        ;;
esac

artifact=$(mktemp "${TMPDIR:-/tmp}/muriel-${commit}.XXXXXX.tar")
chmod 600 "$artifact"
remote_artifact=

cleanup() {
    status=$1
    cleanup_failed=0
    trap - EXIT HUP INT TERM

    if [ -n "$remote_artifact" ] && ! ssh "$ssh_target" "rm -f -- '$remote_artifact'"; then
        printf '%s\n' "Could not remove remote deployment archive; it may remain at $remote_artifact." >&2
        cleanup_failed=1
    fi
    if ! rm -f -- "$artifact"; then
        printf '%s\n' "Could not remove local deployment archive; it may remain at $artifact." >&2
        cleanup_failed=1
    fi

    [ "$status" -ne 0 ] && exit "$status"
    [ "$cleanup_failed" -eq 0 ] || exit 1
}

trap 'cleanup "$?"' EXIT
trap 'cleanup 129' HUP
trap 'cleanup 130' INT
trap 'cleanup 143' TERM

git -C "$repo_root" archive --worktree-attributes --format=tar "$commit" > "$artifact"
if tar -tf "$artifact" | grep -Eq '(^|/)(\.venv|\.env|secrets|attempts)(/|$)|(^|/)db\.sqlite3$'; then
    printf '%s\n' "Deployment artifact contains excluded development or secret material." >&2
    exit 1
fi

printf 'Deploying commit %s to %s.\n' "$commit" "$1"
remote_candidate=$(ssh "$ssh_target" "umask 077 && mktemp --suffix=.tar /tmp/muriel-${commit}.XXXXXX")
case "$remote_candidate" in
    "/tmp/muriel-${commit}."[[:alnum:]][[:alnum:]][[:alnum:]][[:alnum:]][[:alnum:]][[:alnum:]].tar) ;;
    *)
        printf '%s\n' "Deployment host returned an unsafe temporary archive path." >&2
        exit 1
        ;;
esac
remote_artifact=$remote_candidate

scp "$artifact" "$ssh_target:$remote_artifact"
ssh -tt "$ssh_target" "sudo /srv/muriel/deploy-release $commit < '$remote_artifact'"
