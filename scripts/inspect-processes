#!/bin/sh
set -eu

usage() {
    printf '%s\n' "Usage: $0 PID [PID ...]" >&2
}

if [ "$#" -eq 0 ]; then
    usage
    exit 2
fi

pids=
for pid in "$@"; do
    case "$pid" in
        ""|0|*[!0-9]*)
            printf 'Invalid PID: %s\n' "$pid" >&2
            usage
            exit 2
            ;;
    esac

    if [ -z "$pids" ]; then
        pids=$pid
    else
        pids="$pids,$pid"
    fi
done

exec ps -p "$pids" -o pid,ppid,pgid,stat,etime,%cpu,%mem,comm,args
