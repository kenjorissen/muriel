#!/bin/sh
# Explicit network-enabled setup; never called by scripts/check.
set -eu
case "${1:-}" in
    "") with_deps=--with-deps ;;
    --browser-only) with_deps= ;;
    *) printf '%s\n' 'Usage: scripts/setup-browser [--browser-only]' >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then
    printf '%s\n' 'Usage: scripts/setup-browser [--browser-only]' >&2
    exit 2
fi
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
installation=$(node "$script_dir/browser-tooling.cjs" --installation-directory)
printf 'Installing shared browser tooling in %s\n' "$installation"
mkdir -p "$installation"
cp "$script_dir/../tools/browser/package.json" "$script_dir/../tools/browser/package-lock.json" "$installation/"
cd "$installation"
npm ci --include=dev
# Hermetic browser storage belongs to the shared installation, not this Attempt.
PLAYWRIGHT_BROWSERS_PATH=0 node node_modules/playwright/cli.js install $with_deps chromium
node "$script_dir/browser-tooling.cjs"
