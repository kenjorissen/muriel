#!/bin/sh
set -eu

usage() {
    printf '%s\n' "usage: $0 WORKTREE" >&2
    exit 2
}

[ "$#" -eq 1 ] || usage

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
if ! git_common_dir=$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    printf '%s\n' "Unable to determine the shared Git common directory for $repo_root." >&2
    exit 1
fi
main_root=$(CDPATH= cd -- "$git_common_dir/.." && pwd -P)

if ! preview_root=$(CDPATH= cd -- "$1" && pwd -P); then
    printf '%s\n' "Preview worktree does not exist: $1" >&2
    exit 1
fi
if ! preview_common_dir=$(git -C "$preview_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    printf '%s\n' "Preview target is not a Git worktree: $preview_root" >&2
    exit 1
fi
if [ "$preview_common_dir" != "$git_common_dir" ]; then
    printf '%s\n' "Preview target is not a worktree of this repository: $preview_root" >&2
    exit 1
fi
if [ ! -f "$preview_root/manage.py" ] || [ ! -d "$preview_root/preceptor_project" ]; then
    printf '%s\n' "Preview target is not a Muriel application worktree: $preview_root" >&2
    exit 1
fi

python="$main_root/.venv/bin/python"
if [ ! -x "$python" ]; then
    printf '%s\n' "Missing shared virtual environment at $main_root/.venv." >&2
    exit 1
fi

runtime_dir=$(mktemp -d /tmp/muriel-preview.XXXXXX)
server_pid=
cleanup() {
    if [ -n "$server_pid" ]; then
        kill "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    case "$runtime_dir" in
        /tmp/muriel-preview.*) rm -rf -- "$runtime_dir" ;;
        *) printf '%s\n' "Refusing to clean unexpected preview path: $runtime_dir" >&2 ;;
    esac
}
trap cleanup EXIT HUP INT TERM

database="$runtime_dir/db.sqlite3"
if [ -f "$main_root/db.sqlite3" ]; then
    cp -- "$main_root/db.sqlite3" "$database"
fi
printf '%s\n' \
    'import os' \
    'from preceptor_project.settings import *  # noqa: F403' \
    'DATABASES["default"]["NAME"] = os.environ["MURIEL_PREVIEW_DATABASE"]  # noqa: F405' \
    > "$runtime_dir/preview_settings.py"

cd "$preview_root"
PYTHONPATH="$runtime_dir" \
    MURIEL_PREVIEW_DATABASE="$database" \
    DJANGO_SETTINGS_MODULE=preview_settings \
    "$python" manage.py migrate --noinput

bind_address=${PRECEPTOR_BIND_ADDRESS:-127.0.0.1}
server_address="$bind_address:8001"
printf '%s\n' "Previewing $preview_root at http://$server_address/"
printf '%s\n' "Using isolated runtime data in $runtime_dir; it will be removed when the server stops."
PYTHONPATH="$runtime_dir" \
    MURIEL_PREVIEW_DATABASE="$database" \
    DJANGO_SETTINGS_MODULE=preview_settings \
    "$python" manage.py runserver "$server_address" --noreload &
server_pid=$!
wait "$server_pid"
