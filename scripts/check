#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
if ! git_common_dir=$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    printf '%s\n' "Unable to determine the shared Git common directory for $repo_root." >&2
    exit 1
fi
if ! main_root=$(CDPATH= cd -- "$git_common_dir/.." && pwd -P); then
    printf '%s\n' "Unable to determine the shared main repository root from $git_common_dir." >&2
    exit 1
fi

if [ -x "$main_root/.venv/bin/python" ]; then
    python="$main_root/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    python=python3
elif command -v python >/dev/null 2>&1; then
    python=python
else
    printf '%s\n' "No usable Python interpreter found. Use $main_root/.venv/bin/python, python3, or python." >&2
    exit 1
fi

ruff="$main_root/.venv/bin/ruff"
if [ ! -x "$ruff" ]; then
    printf '%s\n' "Ruff is not installed. Install development dependencies with $main_root/.venv/bin/python -m pip install -r $repo_root/requirements-dev.txt." >&2
    exit 1
fi

cd "$repo_root"
if ! command -v node >/dev/null 2>&1; then
    printf '%s\n' 'Browser checks require Node 22+; then run ./scripts/setup-browser.' >&2
    exit 1
fi
node scripts/browser-tooling.cjs
"$ruff" check .
"$ruff" format --check .
node --test schedules/tests/period_picker.test.js schedules/tests/physicians_picker.test.js schedules/tests/role_attributes.test.js schedules/tests/schedule_report_controls.test.js schedules/tests/faculty_admin_time_report_controls.test.js schedules/tests/precepting_solve_controls.test.js schedules/tests/vacation_calendar.test.js schedules/tests/calendar_week_actions.test.js schedules/tests/academic_event_form.test.js schedules/tests/capacity_override_control.test.js schedules/tests/form_processing_feedback.test.js schedules/tests/monthly_annual_window.test.js
DJANGO_SETTINGS_MODULE=preceptor_project.test_settings "$python" manage.py check
DJANGO_SETTINGS_MODULE=preceptor_project.test_settings "$python" manage.py test --parallel=4 --timing --durations=10 --exclude-tag=synthetic-solver-integration --exclude-tag=synthetic-scenario-integration --exclude-tag=reset-tool-integration
