#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
main_worktree=$(git -C "$repo_root" worktree list --porcelain | while IFS= read -r line; do
    case "$line" in
        worktree\ *) candidate=${line#worktree } ;;
        "branch refs/heads/main") printf '%s\n' "$candidate"; exit 0 ;;
    esac
done)

if [ -z "$main_worktree" ] || [ "$repo_root" != "$main_worktree" ]; then
    printf '%s\n' "reset-synthetic must be run from the canonical main worktree." >&2
    exit 1
fi

python="$repo_root/.venv/bin/python"
if [ ! -x "$python" ]; then
    printf '%s\n' "Missing virtual environment at $repo_root/.venv. Create it before resetting synthetic data." >&2
    exit 1
fi

cd "$repo_root"
exec "$python" manage.py reset_synthetic "$@"
